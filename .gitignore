# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/

# Tooling caches. Listed explicitly rather than as a bare `.*`, which would also
# swallow .github/, .pre-commit-config.yaml, .ruff.toml and .env.example.
.vscode/
.idea/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.DS_Store

# Data and derived artifacts — never committed
/images/
/data/
/outputs/
/runs/
/predictions_tiff/
/avg_cache/
*.ckpt
*.log
*.npy
*.raw
*.CLB
*.pt
*.pth
*.tif
*.tiff
*.npz

# Local-only trees
/.research/
/graphify-out/
/Backup/
/MATLAB/

# Office documents
*.docx
*.pptx

# Local data mappings
data_map.json
